{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Ejecutar tests",
			"type": "shell",
			"command": "python",
			"args": ["-m", "pytest", "tests", "-q"],
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false
			},
			"problemMatcher": []
		},
		{
			"label": "Ayuda del organizador",
			"type": "shell",
			"command": "python",
			"args": ["main.py", "--help"],
			"problemMatcher": []
		},
		{
			"label": "Analizar carpeta de prueba",
			"type": "shell",
			"command": "python",
			"args": ["main.py", "analyze", "--path", "./test_organize"],
			"problemMatcher": []
		},
		{
			"label": "Simular organización de la carpeta de prueba",
			"type": "shell",
			"command": "python",
			"args": ["main.py", "organize", "--path", "./test_organize", "--dry-run"],
			"problemMatcher": []
		},
		{
			"label": "Validar sintaxis",
			"type": "shell",
			"command": "python",
			"args": ["-m", "compileall", "-q", "organizador", "main.py"],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		}
	]
}
