# Organizador de Carpetas — configuración opcional.
# Copia este archivo a .env y ajusta lo que necesites. Las variables que ya
# estén en el entorno tienen prioridad sobre lo que ponga aquí.

# Archivo JSON de reglas. Si no existe, se usan las reglas por defecto.
CONFIG_FILE=config/rules.json

# Nivel de detalle del log: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Archivo donde guardar el log. Déjalo vacío para no escribir ninguno.
LOG_FILE=organizer.log

# Qué hacer con los archivos repetidos:
#   quarantine  mueve las copias a _Duplicados (por defecto; no borra nada)
#   report      sólo las lista, no las mueve
#   ignore      no comprueba duplicados (no lee el contenido de ningún archivo)
DUPLICATE_POLICY=quarantine

# Destino por defecto de `move-projects`.
PROJECTS_DESTINATION=
